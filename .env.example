# KeeperHub org-scoped API key (kh_ prefix)
KH_API_KEY=kh_your_key_here

# Wallet address with the Aave V3 position on Base
USER_ADDRESS=0xYourWalletAddress

# Trigger defensive repay when health factor drops below this (default: 1.25)
HF_THRESHOLD=1.25

# USDC amount to repay per defend action (default: 5)
REPAY_AMOUNT_USDC=5

# Base mainnet chain ID
NETWORK=8453

# --- Reasoning layer (LangChain) ---

# Either OPENAI_API_KEY or ANTHROPIC_API_KEY. If neither is set, Sentry falls
# back to the rule-based decision in src/decide.ts.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional model override (default: gpt-4o-mini / claude-sonnet-4-5)
LLM_MODEL=

# True: never execute onchain — the agent returns decisions only (safe demo mode)
DRY_RUN=false

# Hard floor for immediate action (default: 1.05)
HF_HARD_FLOOR=1.05

# Min 5-min drawdown % for "real risk" vs noise (default: 3)
DRAWDOWN_TRIGGER_PCT=3

# --- Phase 3: paid x402/MPP risk-check workflow ---
# Slug of the published risk-check workflow (default: sentry-risk-check)
WORKFLOW_SLUG=sentry-risk-check

# Optional: remote @keeperhub/wallet MCP URL to auto-pay 402 challenges
KH_WALLET_MCP_URL=

# --- Phase 4: audit trail ---
# Where `npm run audit` writes the rendered markdown (default: audit.md)
AUDIT_OUT_FILE=audit.md
